<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/tab_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_glass"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tab_calls"
            style="@style/TabItem">
            <ImageView
                android:id="@+id/icon_calls"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_calls" />
            <TextView
                android:id="@+id/label_calls"
                style="@style/TabLabel"
                android:text="@string/tab_calls" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_contacts"
            style="@style/TabItem">
            <ImageView
                android:id="@+id/icon_contacts"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_contacts" />
            <TextView
                android:id="@+id/label_contacts"
                style="@style/TabLabel"
                android:text="@string/tab_contacts" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_settings"
            style="@style/TabItem">
            <ImageView
                android:id="@+id/icon_settings"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_settings" />
            <TextView
                android:id="@+id/label_settings"
                style="@style/TabLabel"
                android:text="@string/tab_settings" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
